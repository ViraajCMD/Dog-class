class Dog:
    animal = "Dog"

    def __init__(self, breed, colour):
        self.breed = breed
        self.colour = colour

dog1 = Dog("Golden Retriever", "Golden")
dog2 = Dog("German Shepherd", "Black and Tan")

print(dog1.animal, "-", dog1.breed, ":", dog1.colour)
print(dog2.animal, "-", dog2.breed, ":", dog2.colour)
